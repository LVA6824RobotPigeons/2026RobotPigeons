{
  "$schema": "bcnp_schema.json",
  "version": "3.3",
  "namespace": "bcnp",
  "description": "BCNP autonomous planner schema used by 2026RobotPigeons.",
  "messages": [
    {
      "id": 2001,
      "name": "AutoPlanRequest",
      "description": "Request planner route for selected autonomous profile and current robot pose.",
      "fields": [
        { "name": "profileId", "type": "uint16" },
        { "name": "alliance", "type": "uint8" },
        { "name": "reserved", "type": "uint8" },
        { "name": "poseXmm", "type": "int32" },
        { "name": "poseYmm", "type": "int32" },
        { "name": "headingMilliRad", "type": "int32" }
      ]
    },
    {
      "id": 2002,
      "name": "AutoPlanResponse",
      "description": "Planner response with plan metadata and phase count.",
      "fields": [
        { "name": "planId", "type": "uint32" },
        { "name": "flags", "type": "uint16" },
        { "name": "phaseCount", "type": "uint16" },
        { "name": "planChecksum", "type": "uint32" }
      ]
    },
    {
      "id": 2003,
      "name": "AutoPhaseCommand",
      "description": "Planner-issued phase command metadata for robot executor.",
      "fields": [
        { "name": "planId", "type": "uint32" },
        { "name": "phaseSeq", "type": "uint16" },
        { "name": "phaseType", "type": "uint16" },
        { "name": "timeoutMs", "type": "uint16" },
        { "name": "flags", "type": "uint16" },
        { "name": "arg0", "type": "int32" },
        { "name": "arg1", "type": "int32" }
      ]
    },
    {
      "id": 2004,
      "name": "AutoPhaseAck",
      "description": "Robot acknowledgment for phase acceptance/rejection.",
      "fields": [
        { "name": "planId", "type": "uint32" },
        { "name": "phaseSeq", "type": "uint16" },
        { "name": "decision", "type": "uint8" },
        { "name": "reasonCode", "type": "uint8" }
      ]
    },
    {
      "id": 2005,
      "name": "AutoHeartbeat",
      "description": "Session heartbeat for link liveness.",
      "fields": [
        { "name": "sessionId", "type": "uint32" },
        { "name": "sequence", "type": "uint32" },
        { "name": "timestampMs", "type": "uint32" }
      ]
    },
    {
      "id": 2006,
      "name": "AutoAbort",
      "description": "Abort signal from planner or robot safety gate.",
      "fields": [
        { "name": "reasonCode", "type": "uint16" },
        { "name": "source", "type": "uint16" },
        { "name": "detail", "type": "uint32" }
      ]
    },
    {
      "id": 2007,
      "name": "AutoTelemetry",
      "description": "Robot telemetry/status for planner-side diagnostics.",
      "fields": [
        { "name": "planId", "type": "uint32" },
        { "name": "phaseSeq", "type": "uint16" },
        { "name": "state", "type": "uint16" },
        { "name": "estimatedFuelScore", "type": "uint16" },
        { "name": "fallbackActive", "type": "uint16" },
        { "name": "poseXmm", "type": "int32" },
        { "name": "poseYmm", "type": "int32" }
      ]
    }
  ]
}
